blueprint:
  name: Awqaat MT - Prayer Lights (7 slots, overlap-safe, circadian, pause/skip)
  description: A dedicated lights blueprint for the 5 daily Salaah plus Jumuah and Taraweeh. Each of the
    7 slots independently chooses how it turns ON and OFF (minutes before/after a time sensor, and/or
    a trigger entity, with optional conditions on the trigger-entity option). All 7 slots share one ON
    action and one OFF action, kept overlap-safe by a shared Counter helper. Dhuhr can exclude Fridays;
    Jumuah only ever fires on Fridays. Each slot (plus global) has one-shot 'skip next ON/OFF' helpers,
    and one global pause Timer holds everything — ON, OFF, circadian — until it finishes. Optionally keeps
    target light(s) on a circadian colour-temperature curve.
  domain: automation
  input:
    fajr_section:
      name: Fajr
      collapsed: true
      input:
        fajr_entity:
          name: Fajr - time sensor
          description: The Awqaat MT time sensor for Fajr (used by the "minutes before/after" option below).
          default: null
          selector:
            entity:
              filter:
              - domain: sensor
                device_class: timestamp
        fajr_on_use_time:
          name: Fajr ON - use minutes before
          default: true
          selector:
            boolean: {}
        fajr_on_before_minutes:
          name: Fajr ON - minutes before
          default: 15
          selector:
            number:
              min: 0
              max: 240
              unit_of_measurement: minutes
              mode: box
        fajr_on_use_trigger:
          name: Fajr ON - use a different trigger instead/as well
          default: false
          selector:
            boolean: {}
        fajr_on_trigger_entity:
          name: Fajr ON - trigger entity
          description: e.g. a door sensor or amplifier. Only used if the toggle above is on.
          default: null
          selector:
            entity: {}
        fajr_on_trigger_to_state:
          name: Fajr ON - trigger entity's state to watch for
          description: e.g. "on", "open", "playing". Only used if the toggle above is on.
          default: ''
          selector:
            text: {}
        fajr_on_conditions:
          name: Fajr ON - conditions
          description: Only checked for the trigger-entity option above, not the minutes-before option.
          default: []
          selector:
            condition: {}
        fajr_skip_next_on_entity:
          name: Fajr - 'skip next ON' helper
          description: An input_boolean helper. When it's on, the very next ON for this slot is skipped
            once, then this clears itself automatically.
          default: null
          selector:
            entity:
              filter:
              - domain: input_boolean
        fajr_off_use_time:
          name: Fajr OFF - use minutes after
          default: true
          selector:
            boolean: {}
        fajr_off_anchor_entity:
          name: Fajr OFF - time sensor to measure "after" from
          description: Doesn't have to be Fajr's own sensor — e.g. Fajr can turn off at Sunrise.
          default: null
          selector:
            entity:
              filter:
              - domain: sensor
                device_class: timestamp
        fajr_off_after_minutes:
          name: Fajr OFF - minutes after
          default: 30
          selector:
            number:
              min: 0
              max: 240
              unit_of_measurement: minutes
              mode: box
        fajr_off_use_trigger:
          name: Fajr OFF - use a different trigger instead/as well
          default: false
          selector:
            boolean: {}
        fajr_off_trigger_entity:
          name: Fajr OFF - trigger entity
          default: null
          selector:
            entity: {}
        fajr_off_trigger_to_state:
          name: Fajr OFF - trigger entity's state to watch for
          default: ''
          selector:
            text: {}
        fajr_off_conditions:
