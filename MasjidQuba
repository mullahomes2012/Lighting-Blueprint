        on_action:
          name: ON action (shared by all 7 slots)
          description: Whatever should happen when any slot's ON fires — e.g. light.turn_on with brightness/transition.
          default: []
          selector:
            action: {}
        off_action:
          name: OFF action (shared by all 7 slots)
          description: Whatever should happen when a slot's OFF fires and nothing else still wants it
