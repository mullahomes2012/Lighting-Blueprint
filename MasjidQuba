  fajr_on_before_minutes: !input 'fajr_on_before_minutes'
  fajr_off_anchor_entity: !input 'fajr_off_anchor_entity'
  fajr_off_after_minutes: !input 'fajr_off_after_minutes'
  dhuhr_entity: !input 'dhuhr_entity'
  dhuhr_on_before_minutes: !input 'dhuhr_on_before_minutes'
  dhuhr_off_anchor_entity: !input 'dhuhr_off_anchor_entity'
  dhuhr_off_after_minutes: !input 'dhuhr_off_after_minutes'
  asr_entity: !input 'asr_entity'
  asr_on_before_minutes: !input 'asr_on_before_minutes'
  asr_off_anchor_entity: !input 'asr_off_anchor_entity'
  asr_off_after_minutes: !input 'asr_off_after_minutes'
  maghrib_entity: !input 'maghrib_entity'
  maghrib_on_before_minutes: !input 'maghrib_on_before_minutes'
  maghrib_off_anchor_entity: !input 'maghrib_off_anchor_entity'
  maghrib_off_after_minutes: !input 'maghrib_off_after_minutes'
  isha_entity: !input 'isha_entity'
  isha_on_before_minutes: !input 'isha_on_before_minutes'
  isha_off_anchor_entity: !input 'isha_off_anchor_entity'
  isha_off_after_minutes: !input 'isha_off_after_minutes'
  jumuah_entity: !input 'jumuah_entity'
  jumuah_on_before_minutes: !input 'jumuah_on_before_minutes'
  jumuah_off_anchor_entity: !input 'jumuah_off_anchor_entity'
  jumuah_off_after_minutes: !input 'jumuah_off_after_minutes'
  taraweeh_entity: !input 'taraweeh_entity'
  taraweeh_on_before_minutes: !input 'taraweeh_on_before_minutes'
  taraweeh_off_anchor_entity: !input 'taraweeh_off_anchor_entity'
  taraweeh_off_after_minutes: !input 'taraweeh_off_after_minutes'
trigger:
- platform: template
  id: fajr_on_time
  enabled: !input 'fajr_on_use_time'
  value_template: '{{ fajr_entity not in [none, ''''] and states(fajr_entity) not in [''unknown'',''unavailable'',''none'','''']
    and now() >= (as_datetime(states(fajr_entity)) - timedelta(minutes = fajr_on_before_minutes | int))
    }}'
- platform: state
  id: fajr_on_trigger
  enabled: !input 'fajr_on_use_trigger'
  entity_id: !input 'fajr_on_trigger_entity'
  to: !input 'fajr_on_trigger_to_state'
- platform: template
  id: fajr_off_time
  enabled: !input 'fajr_off_use_time'
  value_template: '{{ fajr_off_anchor_entity not in [none, ''''] and states(fajr_off_anchor_entity) not
    in [''unknown'',''unavailable'',''none'',''''] and now() >= (as_datetime(states(fajr_off_anchor_entity))
    + timedelta(minutes = fajr_off_after_minutes | int)) }}'
- platform: state
  id: fajr_off_trigger
