        skip_next_off_global_entity:
          name: Global 'skip next OFF' helper
          description: An input_boolean helper. When on, the very next OFF across ANY slot is skipped
            once, then clears itself.
          default: null
          selector:
            entity:
              filter:
              - domain: input_boolean
        pause_timer_entity:
          name: Pause timer helper
          default: null
          description: A Timer helper. While it's running, this automation does nothing at all — no ON,
            no OFF, no circadian update, for any slot — whatever state things are in just holds. Resumes
            normally on its own once the timer finishes; no other helper needed. Start/cancel it directly
            from its own dashboard card.
          selector:
            entity:
              filter:
              - domain: timer
        circadian_enable:
          name: Follow circadian rhythm
          description: If on, the target light(s) below get their colour temperature set from the sun's
            position whenever something turns on, and re-applied periodically while anything is on.
          default: false
          selector:
            boolean: {}
        circadian_target:
          name: Circadian light target
          description: The light(s) to keep circadian-adjusted. Applied independently of the ON/OFF actions
            above. Required even if you're not using circadian yet -- pick any light; it's simply unused
            while "Follow circadian rhythm" is off.
          selector:
            entity:
              multiple: true
              filter:
              - domain: light
        circadian_min_cct:
          name: Circadian minimum colour temperature (Kelvin)
          description: Used when the sun is at or below the horizon (warmest).
          default: 2000
          selector:
            number:
              min: 1500
              max: 6500
              unit_of_measurement: K
              mode: box
        circadian_max_cct:
          name: Circadian maximum colour temperature (Kelvin)
          description: Used at the sun's highest point of the day (coolest).
          default: 5000
          selector:
            number:
              min: 1500
              max: 6500
              unit_of_measurement: K
              mode: box
        circadian_recompute_interval:
          name: Circadian recompute frequency
          description: How often to re-apply the colour temperature while something is on.
          default: /5
          selector:
            select:
              options:
              - value: /1
                label: Every minute
              - value: /5
                label: Every 5 minutes
              - value: /10
                label: Every 10 minutes
              - value: /15
                label: Every 15 minutes
              - value: /30
                label: Every 30 minutes
