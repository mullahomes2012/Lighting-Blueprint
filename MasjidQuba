              max: 6500
              unit_of_measurement: K
              mode: box
        circadian_max_cct:
          name: Circadian maximum colour temperature (Kelvin)
          description: Used at the sun's highest point of the day (coolest).
          default: 5000
          selector:
            number:
              min: 1500
              max: 6500
              unit_of_measurement: K
              mode: box
        circadian_recompute_interval:
          name: Circadian recompute frequency
          description: How often to re-apply the colour temperature while something is on.
          default: /5
          selector:
            select:
              options:
              - value: /1
                label: Every minute
              - value: /5
                label: Every 5 minutes
              - value: /10
                label: Every 10 minutes
              - value: /15
                label: Every 15 minutes
              - value: /30
                label: Every 30 minutes
mode: queued
max: 20
trigger_variables:
