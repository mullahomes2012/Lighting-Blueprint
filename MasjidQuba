- platform: time_pattern
  id: circadian_tick
  enabled: !input 'circadian_enable'
  minutes: !input 'circadian_recompute_interval'
variables:
  circadian_enable: !input 'circadian_enable'
  circadian_min_cct: !input 'circadian_min_cct'
  circadian_max_cct: !input 'circadian_max_cct'
action:
- choose:
  - conditions:
    - condition: template
      value_template: '{{ trigger.id.endswith(''_on_time'') }}'
    sequence: &id001
    - action: counter.increment
      target:
        entity_id: !input 'counter_entity'
    - choose:
      - conditions: []
        sequence: !input 'on_action'
    - if:
      - condition: template
        value_template: '{{ circadian_enable }}'
      then:
      - action: light.turn_on
        target: !input 'circadian_target'
        data:
          color_temp_kelvin: '{% set elev = state_attr(''sun.sun'', ''elevation'') | float(0) %}{% set
            frac = ((elev - (-4)) / (60 - (-4))) %}{% set frac = [[frac, 0] | max, 1] | min %}{{ (circadian_min_cct
            + frac * (circadian_max_cct - circadian_min_cct)) | round(0) | int }}'
  - conditions:
    - condition: template
      value_template: '{{ trigger.id == ''fajr_on_trigger'' }}'
    - condition: and
      conditions: !input 'fajr_on_conditions'
    sequence: *id001
  - conditions:
    - condition: template
      value_template: '{{ trigger.id == ''dhuhr_on_trigger'' }}'
    - condition: and
      conditions: !input 'dhuhr_on_conditions'
    sequence: *id001
  - conditions:
    - condition: template
      value_template: '{{ trigger.id == ''asr_on_trigger'' }}'
    - condition: and
      conditions: !input 'asr_on_conditions'
    sequence: *id001
  - conditions:
    - condition: template
      value_template: '{{ trigger.id == ''maghrib_on_trigger'' }}'
    - condition: and
      conditions: !input 'maghrib_on_conditions'
    sequence: *id001
  - conditions:
    - condition: template
      value_template: '{{ trigger.id == ''isha_on_trigger'' }}'
    - condition: and
      conditions: !input 'isha_on_conditions'
    sequence: *id001
  - conditions:
    - condition: template
      value_template: '{{ trigger.id == ''jumuah_on_trigger'' }}'
    - condition: and
      conditions: !input 'jumuah_on_conditions'
    sequence: *id001
  - conditions:
    - condition: template
      value_template: '{{ trigger.id == ''taraweeh_on_trigger'' }}'
    - condition: and
      conditions: !input 'taraweeh_on_conditions'
    sequence: *id001
  - conditions:
    - condition: template
      value_template: '{{ trigger.id.endswith(''_off_time'') }}'
    sequence: &id002
    - action: counter.decrement
      target:
        entity_id: !input 'counter_entity'
    - condition: numeric_state
      entity_id: !input 'counter_entity'
      below: 1
    - choose:
      - conditions: []
        sequence: !input 'off_action'
  - conditions:
    - condition: template
      value_template: '{{ trigger.id == ''fajr_off_trigger'' }}'
    - condition: and
      conditions: !input 'fajr_off_conditions'
    sequence: *id002
  - conditions:
    - condition: template
      value_template: '{{ trigger.id == ''dhuhr_off_trigger'' }}'
    - condition: and
      conditions: !input 'dhuhr_off_conditions'
    sequence: *id002
  - conditions:
    - condition: template
      value_template: '{{ trigger.id == ''asr_off_trigger'' }}'
    - condition: and
      conditions: !input 'asr_off_conditions'
    sequence: *id002
  - conditions:
    - condition: template
      value_template: '{{ trigger.id == ''maghrib_off_trigger'' }}'
    - condition: and
      conditions: !input 'maghrib_off_conditions'
    sequence: *id002
  - conditions:
    - condition: template
      value_template: '{{ trigger.id == ''isha_off_trigger'' }}'
    - condition: and
      conditions: !input 'isha_off_conditions'
    sequence: *id002
  - conditions:
    - condition: template
      value_template: '{{ trigger.id == ''jumuah_off_trigger'' }}'
    - condition: and
      conditions: !input 'jumuah_off_conditions'
    sequence: *id002
  - conditions:
    - condition: template
      value_template: '{{ trigger.id == ''taraweeh_off_trigger'' }}'
    - condition: and
      conditions: !input 'taraweeh_off_conditions'
    sequence: *id002
  - conditions:
    - condition: template
      value_template: '{{ trigger.id == ''circadian_tick'' }}'
    sequence:
    - condition: not
      conditions:
      - condition: numeric_state
        entity_id: !input 'counter_entity'
        below: 1
    - if:
      - condition: template
        value_template: '{{ circadian_enable }}'
      then:
      - action: light.turn_on
        target: !input 'circadian_target'
        data:
          color_temp_kelvin: '{% set elev = state_attr(''sun.sun'', ''elevation'') | float(0) %}{% set
            frac = ((elev - (-4)) / (60 - (-4))) %}{% set frac = [[frac, 0] | max, 1] | min %}{{ (circadian_min_cct
            + frac * (circadian_max_cct - circadian_min_cct)) | round(0) | int }}'
